# Environment variables for the Kratt mobile app.
# Copy to `.env` and fill in. Only names prefixed EXPO_PUBLIC_ are readable
# from app code (via process.env.EXPO_PUBLIC_*).

# Base URL of the Kratt backend, per docs/api-contract.md.
#   Local dev:  http://localhost:8000
#   Deployed:   fill in once the backend track shares the Render/Railway URL
# The app currently runs on lib/mockApi.js; this variable documents the switch
# target for when AnalysisContext swaps to the real `POST /analyze`.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
