# Environment variables for the Kratt mobile app.
# Copy to `.env` and fill in. Only names prefixed EXPO_PUBLIC_ are readable
# from app code (via process.env.EXPO_PUBLIC_*).

# Base URL of the Kratt backend, per docs/api-contract.md.
#   Web preview / same machine:  http://localhost:8000
#   Physical device on your LAN:  http://<your-computer-LAN-ip>:8000
#     (localhost on a phone points at the phone, not your dev machine)
# AnalysisContext now calls the real POST /analyze (lib/api.js) using this.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to 1 to keep using the built-in mock (lib/mockApi.js) for offline UI work.
# Leave empty to hit the real backend above.
EXPO_PUBLIC_USE_MOCK=
