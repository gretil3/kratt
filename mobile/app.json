{
  "expo": {
    "name": "Kratt",
    "slug": "kratt-mobile",
    "scheme": "kratt",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#08080B",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#08080B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"]
  }
}
