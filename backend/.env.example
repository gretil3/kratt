# Copy to backend/.env and fill in. .env is gitignored — never commit real keys.

# Required: YouTube Data API v3 key (console.cloud.google.com -> enable
# "YouTube Data API v3" -> Credentials -> API key).
YOUTUBE_API_KEY= AIzaSyBUJS17JO0z0CU179ghVxk3pIekKXn2A_Q

# --- optional (sensible defaults) ---

# Trained authenticity classifier on the Hugging Face Hub.
KRATT_MODEL_REPO=geraldadli/Kratt
# Set to 0 for a fast rules-only dev loop (skips the ~1GB model download).
KRATT_ENABLE_BERT=1
# Persistent cache path for the downloaded model. Leave empty for the default
# (~/.cache/huggingface/hub). Set this to a PERSISTENT DISK path if your host
# wipes local disk on every restart/redeploy (most PaaS free tiers) -- otherwise
# you re-download ~1GB on every cold start.
KRATT_MODEL_CACHE_DIR=
# Load the model in the background at startup instead of on the first request.
KRATT_WARM_UP_MODEL=1
# P(authentic) at/above this counts as genuine; below it counts as bot. Lower
# = catch more bots (more false positives on real comments); higher = fewer
# false positives (more bots slip through). Tune after checking real results,
# not blindly -- see the niche-inference fix first if bot% looks too high.
KRATT_BOT_THRESHOLD=0.5

# Max comments fetched + scored per request (bounds latency; BERT on CPU is slow).
KRATT_MAX_COMMENTS=300
# Skip reply threads with fewer than this many replies -- each thread costs one
# full API call regardless of its reply count (no batch-multi-parent endpoint
# exists), so a call spent on a 1-reply thread is poor value vs. a top-level
# page that returns up to 100 comments for the same cost.
KRATT_MIN_REPLIES_TO_FETCH=2
# Example flagged comments returned as evidence.
KRATT_MAX_SAMPLES=6

# Niche inference (the model needs a niche the raw video doesn't carry).
# Force every video to one niche for testing: genuine | copycat | low-effort
KRATT_FORCE_NICHE=
# Fallback when neither title/description keywords nor category can decide.
KRATT_DEFAULT_NICHE=genuine

# Optional LLM pattern pass (stub in this build).
KRATT_ENABLE_LLM_PASS=0

# CORS: '*' for dev, or a comma-separated allowlist of origins.
KRATT_CORS_ORIGINS=*
