# Copy to backend/.env and fill in. .env is gitignored — never commit real keys.

# Required: YouTube Data API v3 key (console.cloud.google.com -> enable
# "YouTube Data API v3" -> Credentials -> API key).
YOUTUBE_API_KEY=

# --- optional (sensible defaults) ---

# Trained authenticity classifier on the Hugging Face Hub.
KRATT_MODEL_REPO=geraldadli/Kratt
# Set to 0 for a fast rules-only dev loop (skips the ~1GB model download).
KRATT_ENABLE_BERT=1

# Max comments fetched + scored per request (bounds latency; BERT on CPU is slow).
KRATT_MAX_COMMENTS=300
# Example flagged comments returned as evidence.
KRATT_MAX_SAMPLES=6

# Niche inference (the model needs a niche the raw video doesn't carry).
# Force every video to one niche for testing: genuine | copycat | low-effort
KRATT_FORCE_NICHE=
# Fallback when category/duration can't decide.
KRATT_DEFAULT_NICHE=genuine

# Optional LLM pattern pass (stub in this build).
KRATT_ENABLE_LLM_PASS=0

# CORS: '*' for dev, or a comma-separated allowlist of origins.
KRATT_CORS_ORIGINS=*
